# Uses a Telegram bot to send your daily prompt and save your replies as entries.
# Create a free bot via @BotFather in Telegram, then paste its token here.
TELEGRAM_BOT_TOKEN=

# Optional: override the default port (3001)
# PORT=3001

# Optional: secret used to sign session cookies. If unset, a random secret is
# generated on first run and saved to data/session-secret — fine for a single
# self-hosted instance, but set this explicitly if you ever run more than one
# server process (they'd otherwise reject each other's session cookies).
# SESSION_SECRET=

# Needed for "Forgot password?" to actually send an email. Any standard SMTP
# provider works — e.g. a Gmail account with an app password, or SendGrid/
# Mailgun/etc.'s SMTP relay. Each user must also have an email saved on their
# account (Settings > Account) for reset emails to reach them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER if unset
SMTP_FROM=
