<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Journal — Reset password</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="page narrow">
    <header class="top">
      <h1>📓 Daily Journal</h1>
    </header>

    <h2>Set a new password</h2>

    <% if (!valid) { %>
      <p class="error-banner">This reset link is invalid or has expired.</p>
      <a class="goals-manage-link" href="/forgot-password">Request a new link</a>
    <% } else { %>
      <% if (error) { %><p class="error-banner"><%= error %></p><% } %>
      <form method="POST" action="/reset-password/<%= token %>" class="settings-form">
        <label>
          New password
          <input type="password" name="password" autofocus required />
        </label>
        <label>
          Confirm new password
          <input type="password" name="confirm" required />
        </label>
        <button type="submit">Reset password</button>
      </form>
    <% } %>
  </div>
</body>
</html>
