<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Journal — Forgot password</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="page narrow">
    <header class="top">
      <h1>📓 Daily Journal</h1>
    </header>

    <h2>Reset your password</h2>

    <% if (!mailerConfigured) { %>
      <p class="notice">
        Email isn't configured on this server yet. Set <code>SMTP_HOST</code>, <code>SMTP_USER</code>, and
        <code>SMTP_PASS</code> in <code>.env</code> and restart the app before reset links can be sent.
      </p>
    <% } %>

    <% if (message) { %>
      <p class="saved-banner"><%= message %></p>
    <% } else { %>
      <p class="empty">Enter the email on your account and we'll send you a link to reset your password.</p>
      <% if (error) { %><p class="error-banner"><%= error %></p><% } %>
      <form method="POST" action="/forgot-password" class="settings-form">
        <label>
          Email
          <input type="email" name="email" autofocus required />
        </label>
        <button type="submit">Send reset link</button>
      </form>
    <% } %>

    <a class="goals-manage-link" href="/login">Back to log in</a>
  </div>
</body>
</html>
