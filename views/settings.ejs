<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Journal — Settings</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="page">
    <%- include('partials/header') %>

    <% if (message) { %><p class="saved-banner"><%= message %></p><% } %>
    <% if (error) { %><p class="error-banner"><%= error %></p><% } %>

    <h2>Account</h2>

    <% if (!user.email) { %>
      <p class="notice">
        No email on file yet. Add one so you can use "Forgot password?" if you're ever locked out.
      </p>
    <% } %>

    <form method="POST" action="/settings/account" class="settings-form">
      <label>
        Email
        <input type="email" name="email" value="<%= user.email || '' %>" />
      </label>
      <button type="submit">Save email</button>
    </form>

    <h2>Telegram reminder</h2>

    <% if (!telegramConfigured) { %>
      <p class="notice">
        Telegram isn't configured yet. Create a free bot via
        <a href="https://t.me/BotFather" target="_blank" rel="noopener">@BotFather</a>,
        add its token as <code>TELEGRAM_BOT_TOKEN</code> to the <code>.env</code>
        file in the project folder, then restart the app.
      </p>
    <% } else if (!settings.telegram_chat_id) { %>
      <% if (settings.telegram_link_code) { %>
        <p class="notice">
          Send this code to the bot in Telegram to link your account:
          <code><%= settings.telegram_link_code %></code>
        </p>
      <% } else { %>
        <p class="notice">Not linked yet.</p>
      <% } %>
      <form method="POST" action="/settings/telegram/link" class="test-form">
        <button type="submit" class="secondary">
          <%= settings.telegram_link_code ? "Generate a new code" : "Generate link code" %>
        </button>
      </form>
    <% } else { %>
      <p class="notice">
        Linked to Telegram chat <code><%= settings.telegram_chat_id %></code>.
        Reply to your daily prompt in Telegram to save it as that day's entry.
      </p>
      <form method="POST" action="/settings/telegram/unlink" class="test-form">
        <button type="submit" class="secondary">Unlink</button>
      </form>
    <% } %>

    <form method="POST" action="/settings" class="settings-form">
      <label class="checkbox-row">
        <input type="checkbox" name="reminder_enabled" <%= settings.reminder_enabled ? "checked" : "" %> />
        Send me a daily reminder message
      </label>

      <label>
        Reminder time
        <input type="time" name="reminder_time" value="<%= settings.reminder_time %>" />
      </label>

      <button type="submit">Save settings</button>
    </form>

    <form method="POST" action="/settings/test" class="test-form">
      <button type="submit" class="secondary">Send test message now</button>
    </form>
  </div>
</body>
</html>
