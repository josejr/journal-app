<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Journal — Settings</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="page">
    <header class="top">
      <h1>📓 Daily Journal</h1>
      <nav>
        <a href="/">Today</a>
        <a href="/history">History</a>
        <a href="/calendar">Calendar</a>
        <a href="/goals">Goals</a>
        <a href="/settings">Settings</a>
      </nav>
    </header>

    <h2>Telegram reminder</h2>

    <% if (!telegramConfigured) { %>
      <p class="notice">
        Telegram isn't configured yet. Create a free bot via
        <a href="https://t.me/BotFather" target="_blank" rel="noopener">@BotFather</a>,
        add its token as <code>TELEGRAM_BOT_TOKEN</code> to the <code>.env</code>
        file in the project folder, then restart the app.
      </p>
    <% } else if (!settings.telegram_chat_id) { %>
      <p class="notice">
        Not linked yet. Open a chat with your bot in Telegram and send it any
        message (e.g. "hi") — it'll link automatically and confirm.
      </p>
    <% } else { %>
      <p class="notice">
        Linked to Telegram chat <code><%= settings.telegram_chat_id %></code>.
        Reply to your daily prompt in Telegram to save it as that day's entry.
      </p>
    <% } %>

    <% if (message) { %><p class="saved-banner"><%= message %></p><% } %>
    <% if (error) { %><p class="error-banner"><%= error %></p><% } %>

    <form method="POST" action="/settings" class="settings-form">
      <label class="checkbox-row">
        <input type="checkbox" name="reminder_enabled" <%= settings.reminder_enabled ? "checked" : "" %> />
        Send me a daily reminder message
      </label>

      <label>
        Reminder time
        <input type="time" name="reminder_time" value="<%= settings.reminder_time %>" />
      </label>

      <button type="submit">Save settings</button>
    </form>

    <form method="POST" action="/settings/test" class="test-form">
      <button type="submit" class="secondary">Send test message now</button>
    </form>
  </div>
</body>
</html>
